# Copia este archivo a .env y rellena los valores. .env esta ignorado por git.
#
# Los datos salen de la consola de Firebase:
#   Configuracion del proyecto > Tus apps > Web
# Firebase se usa SOLO para la autenticacion: los datos viven en PostgreSQL.

FIREBASE_PROJECT_ID=mis-finanzas-364c8
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=mis-finanzas-364c8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mis-finanzas-364c8
VITE_FIREBASE_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Solo para "npm run dev" con la API levantada aparte. Vacio si se sirve todo tras nginx.
VITE_API_URL=http://localhost:8081
