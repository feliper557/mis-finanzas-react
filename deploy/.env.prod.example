# Plantilla del archivo de entorno de produccion.
#
# Copiala al servidor como /opt/misfinanzas/.env, rellena los valores reales y protegela:
#   chmod 600 /opt/misfinanzas/.env
#
# El archivo real nunca se versiona. La notacion de doble guion bajo corresponde a las
# secciones de appsettings.json: "Firebase:ProjectId" se escribe Firebase__ProjectId.

# --- Despliegue -------------------------------------------------------------
# Repositorio de imagenes en minusculas, sin el sufijo /api ni /web.
IMAGE_REPO=ghcr.io/usuario/misfinanzas

# El pipeline pasa el tag real en cada despliegue mediante /opt/misfinanzas/.image-tag.
IMAGE_TAG=latest

# --- Base de datos ----------------------------------------------------------
# Se conecta al PostgreSQL de Lactumama por la red Docker "data". El Host es el NOMBRE DEL
# CONTENEDOR de su base: lactumama-db-1 (confirmado por el equipo de Lactumama).
#
# La contrasena del rol misfinanzas llega por canal privado, es hexadecimal y NO hay que
# escaparla. Este archivo va con chmod 600 y nunca al repositorio.
#
# Maximum Pool Size=10 de las 50 conexiones del motor: es el limite que impide que esta
# aplicacion agote el cupo de Lactumama. No subirlo sin revisar su max_connections.
ConnectionStrings__Default=Host=lactumama-db-1;Port=5432;Database=misfinanzas;Username=misfinanzas;Password=CAMBIAR;Maximum Pool Size=10

ASPNETCORE_ENVIRONMENT=Production

# Seguro con una sola replica, que es el caso.
Database__AutoMigrate=true

# --- Autenticacion ----------------------------------------------------------
# Proyecto de Firebase de MisFinanzas, distinto al de Lactumama. Solo se valida la firma
# contra las claves publicas de Google: no hace falta ninguna credencial de servicio.
Firebase__ProjectId=mis-finanzas-364c8

# --- CORS -------------------------------------------------------------------
# Vacio a proposito: en produccion la SPA y la API comparten origen detras de nginx.
