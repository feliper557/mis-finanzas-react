# Bloque de sitio para el Caddyfile de Lactumama.
#
# NO se aplica desde este proyecto: se ANADE al final de /opt/lactumama/Caddyfile y se activa
# con "caddy validate" seguido de "caddy reload". El procedimiento completo, con verificacion
# y reversion, esta en docs/handoff-lactumama.md (Cambio 3).
#
# Se anade con "cat >>", "tee" o un editor: NUNCA con "sed -i". El Caddyfile esta montado como
# archivo suelto y sed -i crea un inodo nuevo que el contenedor no veria.
#
# {$DOMAIN} es la variable que ya recibe el contenedor de Caddy (lactumama.online), asi que
# esto resuelve a finanzas.lactumama.online sin sustituir nada.
#
# Caddy enruta por nombre de host, asi que este bloque es independiente del de Lactumama.
finanzas.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy misfinanzas-web:80

	log {
		output stdout
		format console
	}
}
